{
  "designSystem": "Savia",
  "layers": ["colors", "rounded", "spacing", "typography"],
  "colors": {
    "light-canvas": "#F8F5EF",
    "light-surface": "#FFFCF7",
    "light-raised": "#F1ECE3",
    "light-text": "#20252B",
    "light-muted": "#53606D",
    "light-border": "#66707B",
    "light-control": "#FFFFFF",
    "light-disabled": "#4F5C67",
    "light-action": "#075A9C",
    "light-focus": "#005EA8",
    "dark-canvas": "#17212B",
    "dark-surface": "#1F2B36",
    "dark-raised": "#293844",
    "dark-text": "#F7F3EA",
    "dark-muted": "#C5D0D8",
    "dark-border": "#9BAAB5",
    "dark-control": "#13202A",
    "dark-disabled": "#BCC8D0",
    "dark-action": "#8DCCFF",
    "dark-focus": "#8DCCFF",
    "state-income-light": "#0A5E55",
    "state-expense-light": "#7A3E16",
    "state-review-light": "#514A8A",
    "state-warning-light": "#6A4A00",
    "state-error-light": "#A22A2A",
    "state-success-light": "#166534",
    "state-income-dark": "#7DE0D0",
    "state-expense-dark": "#FFD0A6",
    "state-review-dark": "#D6CFFF",
    "state-warning-dark": "#FFE08A",
    "state-error-dark": "#FFB4AB",
    "state-success-dark": "#9AE6B4"
  },
  "rounded": {
    "sm": "4px",
    "DEFAULT": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "touch-min": "44px"
  },
  "cssBindings": {
    "light": {
      "selector": ":root",
      "variables": {
        "--savia-canvas": "colors.light-canvas",
        "--savia-surface": "colors.light-surface",
        "--savia-raised": "colors.light-raised",
        "--savia-text": "colors.light-text",
        "--savia-muted": "colors.light-muted",
        "--savia-border": "colors.light-border",
        "--savia-control": "colors.light-control",
        "--savia-disabled": "colors.light-disabled",
        "--savia-action": "colors.light-action",
        "--savia-focus": "colors.light-focus",
        "--savia-state-income": "colors.state-income-light",
        "--savia-state-expense": "colors.state-expense-light",
        "--savia-state-review": "colors.state-review-light",
        "--savia-state-warning": "colors.state-warning-light",
        "--savia-state-error": "colors.state-error-light",
        "--savia-state-success": "colors.state-success-light"
      }
    },
    "dark": {
      "selector": ":root[data-theme=\"dark\"]",
      "variables": {
        "--savia-canvas": "colors.dark-canvas",
        "--savia-surface": "colors.dark-surface",
        "--savia-raised": "colors.dark-raised",
        "--savia-text": "colors.dark-text",
        "--savia-muted": "colors.dark-muted",
        "--savia-border": "colors.dark-border",
        "--savia-control": "colors.dark-control",
        "--savia-disabled": "colors.dark-disabled",
        "--savia-action": "colors.dark-action",
        "--savia-focus": "colors.dark-focus",
        "--savia-state-income": "colors.state-income-dark",
        "--savia-state-expense": "colors.state-expense-dark",
        "--savia-state-review": "colors.state-review-dark",
        "--savia-state-warning": "colors.state-warning-dark",
        "--savia-state-error": "colors.state-error-dark",
        "--savia-state-success": "colors.state-success-dark"
      }
    },
    "invariant": {
      "selector": ":root",
      "variables": {
        "--savia-rounded-sm": "rounded.sm",
        "--savia-rounded": "rounded.DEFAULT",
        "--savia-rounded-md": "rounded.md",
        "--savia-rounded-lg": "rounded.lg",
        "--savia-rounded-xl": "rounded.xl",
        "--savia-rounded-full": "rounded.full",
        "--savia-space-xs": "spacing.xs",
        "--savia-space-sm": "spacing.sm",
        "--savia-space-md": "spacing.md",
        "--savia-space-lg": "spacing.lg",
        "--savia-space-xl": "spacing.xl",
        "--savia-touch-min": "spacing.touch-min",
        "--savia-type-body-md-font-family": "typography.body-md-font-family",
        "--savia-type-body-md-font-size": "typography.body-md-font-size",
        "--savia-type-body-md-font-weight": "typography.body-md-font-weight",
        "--savia-type-body-md-line-height": "typography.body-md-line-height",
        "--savia-type-body-md-letter-spacing": "typography.body-md-letter-spacing",
        "--savia-type-body-md-font-feature-settings": "typography.body-md-font-feature-settings",
        "--savia-type-body-md-font-variation-settings": "typography.body-md-font-variation-settings",
        "--savia-type-label-md-font-family": "typography.label-md-font-family",
        "--savia-type-label-md-font-size": "typography.label-md-font-size",
        "--savia-type-label-md-font-weight": "typography.label-md-font-weight",
        "--savia-type-label-md-line-height": "typography.label-md-line-height",
        "--savia-type-label-md-letter-spacing": "typography.label-md-letter-spacing",
        "--savia-type-label-md-font-feature-settings": "typography.label-md-font-feature-settings",
        "--savia-type-label-md-font-variation-settings": "typography.label-md-font-variation-settings",
        "--savia-type-finance-md-font-family": "typography.finance-md-font-family",
        "--savia-type-finance-md-font-size": "typography.finance-md-font-size",
        "--savia-type-finance-md-font-weight": "typography.finance-md-font-weight",
        "--savia-type-finance-md-line-height": "typography.finance-md-line-height",
        "--savia-type-finance-md-letter-spacing": "typography.finance-md-letter-spacing",
        "--savia-type-finance-md-font-feature-settings": "typography.finance-md-font-feature-settings",
        "--savia-type-finance-md-font-variation-settings": "typography.finance-md-font-variation-settings",
        "--savia-type-editorial-lg-font-family": "typography.editorial-lg-font-family",
        "--savia-type-editorial-lg-font-size": "typography.editorial-lg-font-size",
        "--savia-type-editorial-lg-font-weight": "typography.editorial-lg-font-weight",
        "--savia-type-editorial-lg-line-height": "typography.editorial-lg-line-height",
        "--savia-type-editorial-lg-letter-spacing": "typography.editorial-lg-letter-spacing",
        "--savia-type-editorial-lg-font-feature-settings": "typography.editorial-lg-font-feature-settings",
        "--savia-type-editorial-lg-font-variation-settings": "typography.editorial-lg-font-variation-settings",
        "--savia-type-technical-sm-font-family": "typography.technical-sm-font-family",
        "--savia-type-technical-sm-font-size": "typography.technical-sm-font-size",
        "--savia-type-technical-sm-font-weight": "typography.technical-sm-font-weight",
        "--savia-type-technical-sm-line-height": "typography.technical-sm-line-height",
        "--savia-type-technical-sm-letter-spacing": "typography.technical-sm-letter-spacing",
        "--savia-type-technical-sm-font-feature-settings": "typography.technical-sm-font-feature-settings",
        "--savia-type-technical-sm-font-variation-settings": "typography.technical-sm-font-variation-settings"
      }
    }
  },
  "typography": {
    "body-md-font-family": "Inter, ui-sans-serif, system-ui, sans-serif",
    "body-md-font-size": "1rem",
    "body-md-font-weight": "400",
    "body-md-line-height": "1.5",
    "body-md-letter-spacing": "0em",
    "body-md-font-feature-settings": "\"'kern' 1, 'liga' 1\"",
    "body-md-font-variation-settings": "\"'wght' 400\"",
    "label-md-font-family": "Inter, ui-sans-serif, system-ui, sans-serif",
    "label-md-font-size": "0.875rem",
    "label-md-font-weight": "600",
    "label-md-line-height": "1.25",
    "label-md-letter-spacing": "0.01em",
    "label-md-font-feature-settings": "\"'kern' 1, 'liga' 1\"",
    "label-md-font-variation-settings": "\"'wght' 600\"",
    "finance-md-font-family": "Inter, ui-sans-serif, system-ui, sans-serif",
    "finance-md-font-size": "1rem",
    "finance-md-font-weight": "600",
    "finance-md-line-height": "1.25",
    "finance-md-letter-spacing": "0em",
    "finance-md-font-feature-settings": "\"'tnum' 1, 'kern' 1\"",
    "finance-md-font-variation-settings": "\"'wght' 600\"",
    "editorial-lg-font-family": "Libre Baskerville, Georgia, serif",
    "editorial-lg-font-size": "1.5rem",
    "editorial-lg-font-weight": "400",
    "editorial-lg-line-height": "1.3",
    "editorial-lg-letter-spacing": "-0.01em",
    "editorial-lg-font-feature-settings": "\"'kern' 1, 'liga' 1\"",
    "editorial-lg-font-variation-settings": "\"'wght' 400\"",
    "technical-sm-font-family": "Fira Code, ui-monospace, monospace",
    "technical-sm-font-size": "0.875rem",
    "technical-sm-font-weight": "400",
    "technical-sm-line-height": "1.4",
    "technical-sm-letter-spacing": "0em",
    "technical-sm-font-feature-settings": "\"'liga' 1\"",
    "technical-sm-font-variation-settings": "\"'wght' 400\""
  }
}
